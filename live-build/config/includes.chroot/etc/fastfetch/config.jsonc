{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/desktop-base/yuz-branding/logos/ascii/yuz-ascii-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "separator": "bright_black"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "yellow",
        "at": "white",
        "host": "yellow"
      }
    },
    {
      "type": "separator",
      "string": "────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "OS          ",
      "keyColor": "yellow"
    },
    {
      "type": "host",
      "key": "Host        ",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "BIOS        ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "Kernel      ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Uptime      ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "Packages    ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "Shell       ",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "Resolution  ",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "DE          ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "WM          ",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "WM Theme    ",
      "keyColor": "yellow"
    },
    {
      "type": "theme",
      "key": "Theme       ",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "Icons       ",
      "keyColor": "yellow"
    },
    {
      "type": "cursor",
      "key": "Cursor      ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "Terminal    ",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "CPU         ",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "GPU         ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "Memory      ",
      "keyColor": "yellow"
    },
    {
      "type": "localip",
      "key": "Network     ",
      "keyColor": "yellow",
      "showIpv6": false,
      "showLoop": false
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
